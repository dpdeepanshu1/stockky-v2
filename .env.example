# Phase 1 needs no secrets — Yahoo Finance data is free and keyless.

# Watchlist + notification-channel persistence (free tier at upstash.com).
# Without these, both still work but reset on every restart/redeploy.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Notification channels can ALSO be set from the Notifications tab in the
# app itself (no redeploy needed) — these env vars are only the fallback
# used the first time the notification-service boots with an empty store.
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── real-trade-service: Auto-Pilot (2026-08-27) ─────────────────────────
# Reuses TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above for its own
# buy/sell/fill/rejection notifications — set once, both services use it.
# Create a bot via @BotFather in Telegram, message it once, then open
# https://api.telegram.org/bot<token>/getUpdates in a browser to read
# your numeric chat_id back out of the JSON response.
# AUTO_PILOT_INTERVAL_SECONDS=180      # how often (seconds) the background loop ticks an armed+enabled mode
# AUTO_PILOT_NOTIFY_HEARTBEAT=false    # true = get a Telegram message every tick, even with zero activity
#
# ── real-trade-service: Scheduled Automation (2026-09-01) ────────────────
# Three OPTIONAL, time-of-day features layered on top of Auto-Pilot.
# ALL DEFAULT OFF — turned on/off entirely from the Scheduled Automation
# panel in the Real Automatic Trade tab (that per-mode toggle is the sole
# on/off authority; there is no env-var kill-switch to also set here — that
# existed briefly and was removed 2026-09-01 so the dashboard button alone
# gives full control, no redeploy needed). Each also requires the mode to
# be armed. Test in DEMO first. Only the time-of-day settings live here:
#
# Pre-pick (~09:00 IST pre-open): refresh + rank candidates before the open
# so the queue is warm when the market opens. No order is placed yet.
PREPICK_TIME_IST=09:00
#
# Enter-at-open (~09:20 IST, after NSE opens): run one full entry cycle
# immediately after the open so pre-picked names get entered at the best
# early-session price instead of waiting for the next Auto-Pilot tick.
ENTER_AT_OPEN_TIME_IST=09:15
# group 390: opening fast cadence (real-trade): schedule loop every 5 s and full entry cycle every 20 s (group 399) from 09:10 to 09:30; the entry gate still waits for 09:15; OPENING_FAST_CYCLE_SECONDS=0 turns it off
# OPENING_FAST_START_IST=09:10
# OPENING_FAST_END_IST=09:30
# OPENING_FAST_SCHEDULE_SECONDS=5
# OPENING_FAST_CYCLE_SECONDS=10
# OPENING_GATE_MIN_MINUTES_AFTER_OPEN=0     # group 399: 0 = entries from 09:15:00 (was 0.5)
# OPENING_GATE_RANGE_AFTER_MIN=15
#
# EOD square-off (~15:15 IST, before NSE close): close every open position
# for this mode so nothing is carried overnight (intraday square-off).
# REAL sends MARKET SELLs to Dhan; DEMO closes at the live tick.
EOD_SQUAREOFF_TIME_IST=15:15
#
# How often the schedule-checker loop wakes to compare the clock to the
# above times. 60s means the feature can fire up to 60s late — fine for
# these coarse time targets. Keep ≥ 20.
# SCHEDULE_CHECK_INTERVAL_SECONDS=60
#
# Fast exit-only cadence (independent of the full-cycle interval). Runs
# exit_engine + reconcile every N seconds so stop/target hits are caught
# between full cycles. Keep ≥ 20.
# EXIT_CHECK_INTERVAL_SECONDS=45
#
# IMPORTANT — set this on real-trade-service so live quotes work for REAL mode:
# MARKET_DATA_URL=https://market-data-service-r6d7.onrender.com

# REQUIRED for the deployed frontend to reach the backend. This is baked
# into the static build at BUILD time (Vite), not read at runtime — if you
# deploy the frontend and backend separately, this MUST be set as a build
# environment variable on the frontend host (Render/Vercel/Netlify) and
# point at the api-gateway's public URL, e.g.:
# VITE_API_URL=https://api-gateway-puwd.onrender.com
# If you forget it, Stockky now shows a "Connect backend" banner in the UI
# where you can paste the URL at runtime instead of rebuilding.
# ── Market scan speed (free-tier safe; does NOT shrink universe or change scores) ──
MAX_PARALLEL_SCAN_WORKERS=18
WAKE_BEFORE_SCAN=true
WAKE_WAIT_SECONDS=8
LAST_FULL_SCAN_TTL=900
DECIDE_CACHE_TTL_OPEN=300
DECIDE_CACHE_TTL_CLOSED=21600
SCAN_LITE_DEFAULT=false
YFINANCE_MAX_CONCURRENT=6
YFINANCE_MIN_INTERVAL_SEC=0.08
DECIDE_BATCH_MAX=25
DECIDE_BATCH_CONCURRENCY=8

# ── Upgrade env (free-tier) ──
MAX_PARALLEL_SCAN_WORKERS=18
WAKE_BEFORE_SCAN=true
SCAN_LITE_DEFAULT=false
YFINANCE_MAX_CONCURRENT=6
DECIDE_CACHE_TTL_OPEN=300
DECIDE_CACHE_TTL_CLOSED=21600
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Multi-user CallMeBot: phone1:key1,phone2:key2
CALLMEBOT_USERS=
TRADE_BACKUP_DIR=/app/data/trade_backups

# ── 5-Service Architecture Placeholders (replace after Render deploy) ──
# On the Oracle VM docker-compose gives every service MARKET_DATA_URL=http://market-data-service:8001 and the code default is the same
# (group379), so the Render URL below only matters for a split Render deployment.
API_GATEWAY_URL=https://api-gateway-puwd.onrender.com
MARKET_DATA_URL=https://market-data-service-r6d7.onrender.com
ANALYSIS_INTELLIGENCE_URL=https://analysis-intelligence-service.onrender.com
DECISION_PREDICTION_URL=https://decision-prediction-service.onrender.com
NOTIFICATION_SCHEDULER_URL=https://notification-scheduler-service-x8vc.onrender.com/notification


# ── Persistent Database (Neon or Supabase free Postgres) ──
# Without this, training/trades use ephemeral sqlite (lost on redeploy).
# Neon: https://neon.tech  |  Supabase: https://supabase.com
# Example:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional model store path (default ./model-store)
# MODEL_STORE_PATH=./model-store


# ── Free-tier keep-warm (GitHub Actions) ──
# Enable workflow: .github/workflows/wake-services.yml
# Required secret: API_GATEWAY_URL
# Optional secrets: NOTIFICATION_URL, MARKET_DATA_URL, ANALYSIS_INTELLIGENCE_URL, DECISION_PREDICTION_URL
# Also set DATABASE_URL on decision-prediction-service (Neon/Supabase).
# Redis (Upstash) required for notification outbox persistence:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Daily premarket refresh workflows (GitHub Actions) ──
# All three run before session open and just need the same repo secret:
#   Required secret: API_GATEWAY_URL  (same value as above)
#   .github/workflows/surprise-premarket.yml   — Surprise momentum baselines
#   .github/workflows/ipo-premarket.yml        — IPO Tracker discovery + scoring (~08:50 IST)
#   .github/workflows/hotpicks-premarket.yml   — Hot Picks bulk price pre-feed (~08:45 IST)
# Nothing else to configure — enable each workflow in the repo's Actions tab.

# ── Watchlist scan tuning (api-gateway service) ──────────────────────────
# /scan/watchlist fans out per-symbol upstream lookups with bounded outer
# concurrency (WATCHLIST_SCAN_CONCURRENCY) PLUS a shared cap on total
# concurrent outbound HTTP calls across every symbol/job in one request
# (WATCHLIST_SCAN_HTTP_CONCURRENCY — keep this aligned with
# MAX_PARALLEL_SCAN_WORKERS; going higher risks overloading
# analysis-intelligence-service / market-data-service for every endpoint,
# not just this one). A hard wall-clock deadline
# (WATCHLIST_SCAN_TIMEOUT_SECONDS) means it always responds within budget
# regardless of watchlist size — anything still running past the deadline
# comes back as a skipped entry in "errors" instead of blocking the
# response, and gets up to WATCHLIST_SCAN_GRACE_SECONDS more in the
# background to finish (warming caches for the next call) before its
# connections/threads are force-released. Keep the timeout comfortably
# under whatever client/proxy calls this endpoint.
# WATCHLIST_SCAN_CONCURRENCY=4
# WATCHLIST_SCAN_HTTP_CONCURRENCY=8
# WATCHLIST_SCAN_TIMEOUT_SECONDS=18
# WATCHLIST_SCAN_GRACE_SECONDS=30

# ── IPO Tracker discovery (api-gateway service) ──────────────────────────
# NSE's own unofficial API is free/unlimited and is the primary source —
# no key needed, but it frequently blocks cloud-hosted IPs (Render, AWS).
# ipoalerts.in is the fallback/supplement for VERY RECENT listings only
# (see IPOALERTS_RECENT_WINDOW_DAYS below) and needs a free API key:
#   1. Go to https://ipoalerts.in and sign up for a free account yourself —
#      this requires your own email/phone verification, so it can't be
#      generated on your behalf; it takes about a minute.
#   2. Their dashboard shows your API key after signup — copy it here.
#   3. Free tier = 25 requests/day. This app auto-manages that budget
#      (see IPOALERTS_DAILY_LIMIT) — you don't need to throttle it
#      yourself, but the settings below let you tune it if wanted.
IPOALERTS_API_KEY=
# Stay safely under the 25/day free-tier ceiling (2 requests spent per
# actual fetch; cached fetches spend 0 — see IPOALERTS_CACHE_HOURS).
IPOALERTS_DAILY_LIMIT=20
# Only "listed" IPOs within this many days count as "very recent" (today/
# yesterday through last week); "open"/currently-subscribing IPOs always
# pass through since they're inherently current. Keep this small — it's
# what keeps ipoalerts usage worth spending quota on instead of NSE's own
# free (if blockable) calendar.
IPOALERTS_RECENT_WINDOW_DAYS=7
# How long a successful ipoalerts fetch is reused before spending quota
# again. 6h means at most 4 real fetches/day even under constant clicking.
IPOALERTS_CACHE_HOURS=6

# ── AngelOne SmartAPI (market-data-service, §1 primary quote source) ────
# Required for angelone_client.py / angelone_ws_feed.py to activate. If any
# of these four are missing, the service silently falls back to Yahoo/
# yfinance as primary and logs a warning at startup — it does not error.
# ANGELONE_CLIENT_ID: your AngelOne trading client code (e.g. A123456)
# ANGELONE_MPIN: your AngelOne MPIN (numeric login PIN, NOT your password)
# ANGELONE_API_KEY: from smartapi.angelbroking.com, "Market Data" app type
# ANGELONE_TOTP_SECRET: the base32 secret shown once when you enable TOTP
#   for this API key (the same secret you'd scan into an authenticator
#   app) — NOT a 6-digit code, the underlying secret string.
ANGELONE_CLIENT_ID=
ANGELONE_MPIN=
ANGELONE_API_KEY=
ANGELONE_TOTP_SECRET=
#
# group211 — shared AngelOne budget (market-data-service/angelone_budget.py). All optional; blank = default.
# Lanes: POSITION (held symbols) > CANDIDATE (/quote, /quotes/bulk, /history) > BACKGROUND (movers sweep,
# cold part of the feed poll). A lane only takes a token while the bucket keeps a reserve for the lanes above.
# A rate-limit 403/429 from ANY AngelOne endpoint makes every caller skip AngelOne for a cooldown.
# Live view: GET /angelone/budget on market-data-service.
# ANGELONE_BUDGET=1                      # 0 = off (no lanes, no global cooldown)
# ANGELONE_GLOBAL_COOLDOWN_S=30          # first cooldown; doubles on a repeat within 5 min ...
# ANGELONE_SPLIT_COOLDOWN=1             # group227: candle 403 pauses candle callers only, quote 403 quote callers only; 0 = one shared cooldown
# ANGELONE_GLOBAL_COOLDOWN_MAX_S=60      # ... up to this
# ANGELONE_LANE_RESERVE_CANDIDATE=0.25   # share of the bucket burst kept free for POSITION
# ANGELONE_LANE_RESERVE_BACKGROUND=0.5   # share kept free for POSITION + CANDIDATE
# ANGELONE_LANE_MAX_WAIT_S=20            # how long a lane waits for its reserve before the call is shed
# ANGELONE_POSITION_LANE_REFRESH_S=15    # held-symbol cache refresh (0 = no position lane)
# ANGELONE_HOT_DEMAND_WINDOW_S=120       # a /quote lookup keeps the symbol "hot" this long
# ANGELONE_FEED_COLD_INTERVAL_S=30       # feed poll: rest of the universe every N s (0 = old: all, every cycle)
# ANGELONE_FEED_HOT_MAX=100              # cap on the hot (non-held) symbols polled every cycle

# ── Dhan HQ broker connection (real-trade-service) ──────────────────────
# Entered from the frontend (Real Automatic Trade tab → admin login →
# Connect Dhan / Rotate Dhan token) — NOT from this file. Only two things
# are ever typed there: your Dhan Client ID and a Dhan Access Token
# (generate at web.dhan.co → DhanHQ Trading APIs → generate access token).
# Both are encrypted at rest (Fernet) and never sent back to the browser
# after saving. These env vars configure the service around that:
#
# Fernet key used to encrypt the saved Client ID/token at rest. Generate
# once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DHAN_CREDENTIAL_ENC_KEY=
# "sandbox" while testing, "live" once you're trading with the real
# account. Same base URL for both today — kept separate per Dhan's own
# docs in case that changes.
DHAN_ENV=sandbox
# How many days a pasted Dhan access token stays valid before the admin
# panel starts counting down and, at 0, auto-disarms REAL trading until a
# fresh token is pasted. Dhan access tokens are valid for exactly 24 hours
# for every account (SEBI/exchange-mandated, confirmed on Dhan's own docs
# and support pages as of 2026) — do NOT set this higher than 1 or the
# service will think a token is still valid long after Dhan has actually
# rejected it, and REAL orders will silently fail auth instead of the gate
# auto-disarming. Only raise this if Dhan documents a longer-lived token
# type for your specific account/plan.
DHAN_TOKEN_LIFETIME_DAYS=1
# Leave false unless Dhan's TOTP-based auto-refresh is set up and tested for
# your account (needs DHAN_TOTP_SECRET, DHAN_CLIENT_ID, DHAN_PIN also set —
# see auth/dhan_credentials.py). When true, a standalone background loop
# (execution/auto_pilot.py, started automatically at boot) checks
# periodically and mints a fresh Dhan access token BEFORE the current one
# expires, then restores the dhan_connected gate so REAL can be re-armed
# with no manual dashboard step.
DHAN_TOTP_ENABLED=false
# The three below were already read by auth/dhan_credentials.py but were
# missing from this file — without all three set, DHAN_TOTP_ENABLED=true
# still silently falls back to "no token minted" (logged as an error, not
# obvious unless you're watching logs). All three are required together:
#   DHAN_TOTP_SECRET — the base32 TOTP secret shown once when you enable
#                       TOTP on your Dhan account (web.dhan.co → My Profile
#                       → DhanHQ Trading APIs).
#   DHAN_CLIENT_ID    — your Dhan Client ID (same one used for manual paste).
#   DHAN_PIN          — your Dhan trading PIN.
DHAN_TOTP_SECRET=
DHAN_CLIENT_ID=
DHAN_PIN=
# How much runway to leave before expiry when deciding a proactive refresh
# is due, and how often the loop checks. Only used when DHAN_TOTP_ENABLED
# is true above.
DHAN_TOTP_REFRESH_MARGIN_HOURS=2
DHAN_TOTP_REFRESH_CHECK_INTERVAL_SECONDS=900

# ── Opening-quality gate (position-stocks-service + real-trade-service, groups 268-273) ──────────
# From the 09:15 open until OPENING_GATE_SETTLE_IST an entry must pass the gate; afterwards nothing here applies.
# All values below are the defaults, shown commented out. docs/GROUP268_*, GROUP269_*, GROUP270_*, GROUP271_*.
# OPENING_GATE_ENABLED=true
# OPENING_GATE_SETTLE_IST=10:00
# (group370: the OPENING_GATE_SHADOW record-only mode was removed; the opening gate is always live, OPENING_GATE_ENABLED=false is its only off switch.)
# Previous-day candle checks (daily candles come from market-data-service /history via a background cache, never on the entry path).
# 0 turns a check off. A missing/stale previous-day candle holds the entry back while the gate is active.
# OPENING_GATE_MIN_PREVDAY_CLOSE_POS=0.5
# OPENING_GATE_MIN_STOP_ATR_FRAC=0.3
# OPENING_GATE_PREVDAY_TIMEOUT_S=8
# OPENING_GATE_PREVDAY_MAX_AGE_DAYS=6

# ── Dhan Data API (market-data-service, group 270) ──────────────────────────────────────────────────────
# Needs: (1) the Data API subscription active on your Dhan account (separate from the free Trading API),
#        (2) the SAME DHAN_CREDENTIAL_ENC_KEY as above (never generate a new one - stored tokens become unreadable),
#        (3) a valid Dhan access token saved through the Real Auto Trade screen (or DHAN_TOTP_ENABLED=true above).
# market-data-service reads that stored token read-only; there is no token variable here.
DHAN_DATA_ENABLED=1
DHAN_DATA_BASE_URL=https://api.dhan.co/v2
DHAN_SCRIP_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv
# First provider that answers wins: Dhan Data API, then AngelOne, then yfinance (E163; was angelone,yfinance,dhan = Dhan last, the old
# shadow-rollout order). A failed Dhan call (no subscription, expired token, open breaker) falls through to the next one on its own.
# Check what is serving: GET /internal/data-sources and GET /internal/dhan-status on market-data-service. Roll back: put the two lines back to angelone,yfinance,dhan.
QUOTE_PROVIDER_ORDER=dhan,angelone,yfinance
HISTORY_PROVIDER_ORDER=dhan,angelone,yfinance
DHAN_SHADOW_COMPARE=1
# live_quotes writes: auto = only when dhan is the FIRST quote provider (never changes what trading reads in shadow mode)
DHAN_LIVE_WRITE=auto
DHAN_LIVE_POLLER=1
DHAN_LIVE_POLL_S=1.2
DHAN_LIVE_MAX_SYMBOLS=900
# group275: rows per live_quotes transaction (one 900-row MERGE could pass Oracle's 8 s call timeout and lose the batch)
DHAN_LIVE_WRITE_CHUNK=60
# group344: skip a live_quotes row whose price is unchanged for this many seconds (0 = write every row, the old behaviour); held positions are never skipped
DHAN_LIVE_WRITE_REFRESH_S=4
# group347: after a live_quotes Oracle timeout (DPY-4024) write ONLY held-position rows for this many seconds (0 = never back off)
DHAN_LIVE_WRITE_BACKOFF_S=20
# group344: /live-quote answers from the Dhan poller's newest row when it is at most this many seconds old (0 = always read Oracle)
DHAN_LIVE_MEM_MAX_AGE_S=6
# group357: the live_quotes writers (AngelOne feed + Dhan) use their OWN DB pool so a slow MERGE cannot starve the shared KV / credentials pool (0 = share the KV engine, the old behaviour)
LIVE_QUOTES_DB_SEPARATE_ENGINE=1
# group357: that dedicated pool - Oracle default 2 + 1 overflow; Postgres/Neon default 1 + 0 (capped at 2 + 1)
LIVE_QUOTES_DB_POOL_SIZE=2
LIVE_QUOTES_DB_MAX_OVERFLOW=1
LIVE_QUOTES_DB_POOL_TIMEOUT=10
LIVE_QUOTES_DB_POOL_RECYCLE=300
# group357: extra symbols (comma separated) the Dhan poller polls every tick besides the held positions; blank = none
DHAN_POLLER_ALWAYS_SYMBOLS=
# group358: compare the dynamic universe against the event service's subscriptions on the bare symbol (it stores SYM.NS, the scanners give SYM); 0 = old raw-string diff (adds and drops the whole set every sync)
DYNAMIC_UNIVERSE_DIFF_NORMALIZE=1
# group359: api-gateway kv_cache durable READS on a memory miss, issued from the event-loop thread, run on a worker and the loop waits at most this many seconds (then sees a miss; the worker warms the cache when it finishes). 0.1 minimum
KV_LOOP_READ_TIMEOUT_S=1.5
# group359: 0 = read on the loop thread as before
KV_LOOP_READ_GUARD=1
# group359: worker threads / max in-flight durable reads for that guard (past the cap a read is shed as a miss)
KV_LOOP_READ_WORKERS=4
KV_LOOP_READ_MAX_INFLIGHT=64
# group360: real-trade watchlist trigger: 0 = off for all three stale-price checks below (old behaviour)
WATCHLIST_STALE_PRICE_GATE=1
# group360: a row's baseline price is not stored from a tick of unknown age: refuse (default) | allow
WATCHLIST_BASELINE_AGE_UNKNOWN=refuse
# group360: 0 = queue a stock whose feed volume is 0 today (price still = previous close) as before
WATCHLIST_NO_TRADE_HOLD=1
# group344: pause after a transient Dhan credentials read failure (db_unavailable at boot), seconds
DHAN_TRANSIENT_PAUSE_S=5
# group275: /angelone/movers asks Dhan first when dhan is the FIRST quote provider (3 calls); 0 = AngelOne sweep only
DHAN_MOVERS_VIA_DHAN=1
# group275: once Dhan is first and has run a clean session, set these to 0 to stop the redundant AngelOne poll
# (~500 symbols / 3 s) and the Yahoo feed (~250 symbols); leave 1 until then - they are the fallback if Dhan fails
ANGELONE_WS_FEED_ENABLED=1
YAHOO_WS_FEED_ENABLED=1
# group275: api-gateway market movers are priced through market-data /quotes/bulk first; yfinance only for the rest. 0 = old yfinance-only fetch
GATEWAY_MOVERS_VIA_MARKET_DATA=1
GATEWAY_MOVERS_QUOTE_MAX_AGE_S=90
# Rate/batching (Dhan: 1 quote request per second, up to 1000 symbols per request)
DHAN_QUOTE_MIN_INTERVAL_S=1.1
DHAN_QUOTE_MAX_BATCH=1000
DHAN_QUOTE_BATCH_WINDOW_MS=250
DHAN_QUOTE_FRESH_S=2
DHAN_QUOTE_WAIT_S=3.5
DHAN_HIST_MAX_PER_SEC=4
DHAN_INTRADAY_CHUNK_DAYS=30
DHAN_HTTP_TIMEOUT_S=6
DHAN_BREAKER_FAILS=5
DHAN_BREAKER_RECOVERY_S=60
DHAN_AUTH_PAUSE_S=60
# Optional websocket (off; REST polling already covers 1000 symbols per second). Layout not yet verified live.
DHAN_WS_ENABLED=0
# Less common Dhan Data knobs (defaults shown; leave unset unless you have a reason)
# DHAN_QUOTE_ENDPOINT=quote            # quote = full snapshot incl. volume/circuits; ohlc = lighter payload without volume
# DHAN_HOURLY_MAX_DAYS=60              # longest window requested for hourly candles
# DHAN_CREDS_CACHE_S=60                # how long the decrypted Dhan token is cached in market-data-service
# DHAN_WS_URL=wss://api-feed.dhan.co   # only used when DHAN_WS_ENABLED=1
# DHAN_WS_MAX_INSTRUMENTS=4000         # only used when DHAN_WS_ENABLED=1
# Only if real-trade-service uses a DIFFERENT database than market-data-service's cache DB:
DHAN_CREDS_DATABASE_URL=
# Sentiment service: ask market-data-service first for NIFTY/SENSEX (0 = direct yfinance as before)
SENTIMENT_USE_MARKET_DATA=1
# Training data from market-data-service instead of direct yfinance. LEAVE 0 until the adjusted-price check in
# docs/GROUP270_DHAN_DATA_API.md is done.
TRAINING_DATA_VIA_MARKET_DATA=0

# ── group 276 ────────────────────────────────────────────────────────────────────────────────────────────────
# Real-trade watchlist: a row already up more than this fraction above its catalyst price is not queued (it stays
# active and queues when the price comes back inside the limit). 0 = no chase limit (old behaviour).
WATCHLIST_MAX_CHASE_PCT=0.02
# position-stocks reconcile: before booking a REJECTED super-order parent as ERROR, look for a TRADED BUY (and SELL)
# in today's order book (AAATECH). 0 = old behaviour.
DEAD_PARENT_FILL_CHECK=1
# market-data: set 1 to use Dhan's live websocket feed (code exists since group 270, default off). Enable after the REST
# path has had a clean session; polling stays as the fallback.
# DHAN_WS_ENABLED=0

# ── group 277 ────────────────────────────────────────────────────────────────────────────────────────────────
# Real-trade watchlist entry guard on Dhan depth (market-data /quote spread_pct, book_value_5). Unknown depth never blocks.
# Hold back a row whose bid-ask spread is above this percent (0 = off).
WATCHLIST_MAX_SPREAD_PCT=0.5
# Hold back a row whose best-5 book (both sides) holds less than this many rupees (0 = off).
WATCHLIST_MIN_BOOK_VALUE=0

# ── group 278 ────────────────────────────────────────────────────────────────────────────────────────────────
# Price order stays Dhan -> AngelOne -> yfinance (QUOTE_PROVIDER_ORDER / HISTORY_PROVIDER_ORDER in market-data-service);
# GET /internal/data-sources on market-data shows which one is serving. api-gateway /market/indices reads ^NSEI / ^BSESN
# from market-data /history first (0 = ask yfinance directly as before).
INDICES_VIA_MARKET_DATA=1
# Last-resort DIRECT yfinance calls inside api-gateway / analysis-intelligence when market-data has nothing.
# 1 = allowed (default, nothing changes). 0 = never; prices and history then come only through market-data.
GATEWAY_DIRECT_YFINANCE_FALLBACK=1
ANALYSIS_DIRECT_YFINANCE_FALLBACK=1
# Real-trade watchlist: a tick older than this many seconds is not acted on (0 = off).
WATCHLIST_MAX_TICK_AGE_S=30
# group290: entries refuse a price older than this many seconds (re-read once, then the candidate is held / waits). 0 = off
ENTRY_MAX_QUOTE_AGE_S=10
# what to do with a price whose age market-data did not say: refuse (default since group388) | allow (old behaviour, rollback)
ENTRY_QUOTE_AGE_UNKNOWN=refuse
# minutes a candidate with an old price stays queued before it is consumed as a WAIT (0 = never hold)
ENTRY_QUOTE_AGE_HOLD_MIN=10
# group291 (position-stocks): seconds a dead-looking parent order stays OPEN while Dhan's order book cannot be read (0 = old behaviour)
DEAD_PARENT_BOOK_WAIT_S=180
# group292 (position-stocks): the depth gate re-reads a market-data /quote book older than this many seconds once, then treats depth as unknown (never blocks, never sizes). 0 = off
ENTRY_DEPTH_MAX_QUOTE_AGE_S=20
# what to do with a /quote answer that carries no age (older market-data build): allow (default) | refuse
ENTRY_DEPTH_QUOTE_AGE_UNKNOWN=allow
# group322 (position-stocks): a symbol with NO depth reading (no answer, timeout, quote without a book): auto (default) = allow until depth has been seen flowing, then refuse that name | allow = always enter | refuse = never without a reading
ENTRY_DEPTH_MISSING=auto
# group322: how long a seen depth reading counts as "flowing" for auto (seconds; 21600 = 6 h, 0 = whole process)
ENTRY_DEPTH_PROVEN_WINDOW_S=21600
# group292 (real-trade): once per IST trading day from this time, store today's expectancy report and push a short Telegram summary. 0 = off
DAILY_REPORT_ENABLED=1
DAILY_REPORT_TIME_IST=15:45
# group293 (real-trade): while a stored snapshot still has ESTIMATED charges, rebuild it every this many minutes (0 = off) until the cutoff; one "updated" message only if the figures changed
DAILY_REPORT_REFRESH_MINUTES=15
DAILY_REPORT_REFRESH_UNTIL_IST=18:00
# group296 (real-trade): the watchlist trigger does not queue a candidate for a symbol already held (pyramiding off); 0 = old behaviour
ENTRY_WATCHLIST_SKIP_HELD=1
# group297 (real-trade): a BUY still working at the broker (PLACED/PARTIAL, created within the age limit) counts as exposure for the no-pyramiding check; 0 = old behaviour
ENTRY_BLOCK_WORKING_BUY_DUP=1
ENTRY_WORKING_BUY_MAX_AGE_HOURS=24
# group299 (market-data): one fresh fundamentals computation per symbol at a time (a second caller waits and reads the cache); 0 = old behaviour
FUNDAMENTALS_SINGLE_FLIGHT=1
FUNDAMENTALS_JOIN_WAIT_S=40
# group300 (analysis-intelligence): peer fundamentals call to market-data /fundamentals: timeout seconds (was a fixed 15) and how many times a TIMEOUT is retried
PEER_FUNDAMENTALS_TIMEOUT_S=30
PEER_FUNDAMENTALS_TIMEOUT_RETRIES=1


# ── group 279 ────────────────────────────────────────────────────────────────────────────────────────────────
# The gateway's surprise feed, premarket baselines and repair-RSI ask market-data first (Dhan -> AngelOne -> yfinance
# there); direct yfinance only gets what market-data could not give, and GATEWAY_DIRECT_YFINANCE_FALLBACK=0 (above)
# switches that last resort off for them as well as for the movers leftovers and the IPO history. 0 = the old order.
SURPRISE_FEED_VIA_MARKET_DATA=1
PREMARKET_BASELINES_VIA_MARKET_DATA=1
REPAIR_RSI_VIA_MARKET_DATA=1
# While the market is open a market-data quote older than this many seconds is not used for the surprise feed.
SURPRISE_FEED_MAX_QUOTE_AGE_SEC=120
# Premarket baselines from market-data /history: parallel requests and the time budget (seconds) before the rest
# goes to the next source.
PREMARKET_MD_WORKERS=4
PREMARKET_MD_BUDGET_S=300
# position-stocks: the manual BUY now refuses a price whose last tick is older than this (same limit the automatic
# entry has had since 2026-10-05; 0 = off).
ENTRY_MAX_TICK_AGE_S=45
# group389 (position-stocks): skip an automatic entry when the symbol has no live tick at all (no price to check staleness / slippage against); 0 = old behaviour
ENTRY_REQUIRE_LIVE_TICK=1

# ── group 280 ────────────────────────────────────────────────────────────────────────────────────────────────
# position-stocks: Dhan 5-level depth is read from market-data /quote just before an entry. Reject a spread above this
# percent (0 = off) or a best-5 book (both sides, Rs) below ENTRY_MIN_BOOK_VALUE (0 = off). Unknown depth never blocks.
ENTRY_DEPTH_GATE=1
ENTRY_DEPTH_MAX_SPREAD_PCT=0.5
ENTRY_MIN_BOOK_VALUE=0
ENTRY_DEPTH_TIMEOUT_S=2
# position-stocks: read-only Dhan order-update WebSocket (GET /orders/ws-status, GET /orders/ws-compare). On in this template (group 288); the code default stays 0.
DHAN_ORDER_WS_ENABLED=1
# position-stocks (group 287): when the order book proves no fill behind a REJECTED parent but the order-update WebSocket saw
# the entry BUY fully TRADED, keep the row OPEN instead of ERROR. 0 = only log WS_CROSSCHECK. Needs DHAN_ORDER_WS_ENABLED=1.
RECONCILE_USE_ORDER_EVENTS=0
# position-stocks (group 283): shrink an entry to this % of ONE side of the best-5 book (0 = off).
ENTRY_BOOK_MAX_SHARE_PCT=0

# ── group 286 ────────────────────────────────────────────────────────────────────────────────────────────────
# market-data: Dhan 20-level depth over websocket, on demand (GET /depth/{symbol}). Off by default. Layout from Dhan's
# docs, NOT yet checked against a live frame: turn on for one session and read /internal/dhan-status "depth20".
DHAN_DEPTH20_ENABLED=0
# DHAN_DEPTH20_URL=wss://depth-api-feed.dhan.co/twentydepth
# DHAN_DEPTH20_MAX_INSTRUMENTS=50      # symbols held at once (Dhan allows 50 per connection)
# DHAN_DEPTH20_TTL_S=120               # a symbol nobody asked about for this long is unsubscribed
# DHAN_DEPTH20_WAIT_S=1.5              # how long /depth waits for the first book of a new symbol
# DHAN_DEPTH20_STALE_S=30              # a book older than this answers available=false, reason=stale
# DHAN_DEPTH20_IDLE_CLOSE_S=60         # websocket closed after this long with nothing watched
# position-stocks: shrink an entry so it uses at most ENTRY_DEPTH20_MAX_SHARE_PCT % of the ask shares Dhan's 20-level
# book shows within ENTRY_DEPTH20_SLIP_PCT % of the best ask. 0 = off. Needs DHAN_DEPTH20_ENABLED=1 in market-data.
ENTRY_DEPTH20_SLIP_PCT=0
ENTRY_DEPTH20_MAX_SHARE_PCT=50
ENTRY_DEPTH20_WAIT_S=1

# group301 (position-stocks): where the scalper gets its ticks. angelone_ws (default) = own AngelOne WebSocket, unchanged.
# market_data = poll market-data-service POST /quotes/bulk (provider order set by market-data, Dhan first), no AngelOne login needed.
# The poller sends 1 request per POSITION_BULK_POLL_S: open positions first, then POSITION_BULK_CHUNK universe symbols, round robin.
# Rows older than POSITION_BULK_MAX_AGE_S are dropped; no bid/ask in rows, so the spread gate stays fail-open (depth gate unaffected).
# POSITION_FEED_SOURCE=angelone_ws
# POSITION_BULK_POLL_S=1.0
# POSITION_BULK_CHUNK=500
# POSITION_BULK_TIMEOUT_S=8
# POSITION_BULK_MAX_AGE_S=30

# ── Price-based closed-market check (group 319/320) ──────────────────────────────────────────────────────────────
# market-data-service decides from PRICES whether the exchange really traded today: no stock and no Nifty move between
# 09:15 and 10:00 IST on a weekday = closed (a real move later reverses it). GET /market/session serves the verdict;
# the trading services, scheduler, api-gateway, analysis and decision read it through session_proof_client.py
# (cached, never blocks, fail-open: no answer = not closed). All optional, defaults shown.
# SESSION_PROOF_ENABLED=true            # market-data: master switch
# SESSION_PROOF_START_IST=09:15
# SESSION_PROOF_END_IST=10:00
# SESSION_PROOF_MIN_MOVES=1             # symbols that must move to prove the day open
# SESSION_PROOF_MIN_SYMBOLS=10          # stocks that must be observed before "no move" may mean closed
# SESSION_NIFTY_PROBE_S=60              # group320: one Nifty reading a minute while it can matter
# SESSION_NIFTY_MIN_OBS=3               # group320: unchanged Nifty readings needed to close the day on Nifty alone
# SESSION_NIFTY_THREAD=true            # group321: market-data runs the Nifty probe on its own thread (not only in the AngelOne loop)
# SESSION_CLOSED_PROBE_S=300            # AngelOne feed probe interval while the day is judged closed
# SESSION_PROOF_CLIENT_ENABLED=true     # every other service: ask market-data for the verdict
# SESSION_PROOF_CLIENT_TTL_S=30
# SESSION_PROOF_CLIENT_TIMEOUT_S=2
# EXIT_NO_PRICE_ALERT_CYCLES=6          # group321: real-trade - exit cycles in a row with no quote for a held position before a WARNING + Telegram alert (0 = off)
# EXIT_NO_PRICE_ALERT_COOLDOWN_S=900    # group321: at most one such alert per symbol per this many seconds
# group322 (real-trade): one trade may not risk more than the whole daily-loss budget (per-trade risk % is capped at MAX_DAILY_LOSS %). false = old behaviour
RISK_CAP_TRADE_RISK_AT_DAILY_LOSS=true
# group322 (real-trade): minimum % gain over entry before a position may be carried overnight as CNC (about 0.7% delivery round trip + gap risk). 0 = no bar (net-of-costs check still applies)
OVERNIGHT_HOLD_MIN_GAIN_PCT=1.5
# group322/370 (position-stocks): Market Board chase guard. Always live: enforce (default) | off (kill switch); no shadow / auto promotion any more
BOARD_GATE_MODE=enforce
# group322/377 (real-trade): broker-side safety-net stop for CNC positions held since an earlier day. ON by default since group377 (false = kill switch). Never exercised against a live Dhan account: watch the first position in /orders and Dhan's order book (needs eDIS / TPIN authorisation on the holding)
BROKER_STOP_ENABLED=true
# stop trigger = software stop less this % (so the software stop fires first)
BROKER_STOP_BUFFER_PCT=0.5
# move the resting stop up only when the new trigger is higher by this %
BROKER_STOP_MIN_MOVE_PCT=0.25
BROKER_STOP_SYNC_SECONDS=60
# failed cancels before a software SELL goes ahead anyway
BROKER_STOP_CANCEL_MAX_FAILS=3
BROKER_STOP_ALERT_COOLDOWN_S=900
# group411: after Dhan refuses a broker stop for a CDSL eDIS / TPIN reason, do not re-send that symbol for this many seconds (it is retried after, so it self-heals once 'Verify Holdings' is done in the Dhan app). 0 = no backoff (old behaviour)
BROKER_STOP_EDIS_BACKOFF_S=900
# STOP_LOSS_MARKET (default) | STOP_LOSS
BROKER_STOP_ORDER_TYPE=STOP_LOSS_MARKET

# group323: dead-man's-switch ping URL from healthchecks.io (https://hc-ping.com/<uuid>), read ONLY by
# scripts/vm_ops.sh (never by a service). `bash scripts/vm_ops.sh heartbeat` installs the 5-minute cron from it.
HC_PING_URL=

# ── group 329 (2026-10-12): circuit-band, results-day, depth re-check, weekend carry (both trading services; all fail open) ──
# CIRCUIT_GATE_ENABLED=true
# CIRCUIT_UPPER_BUFFER_PCT=1.0        # no BUY within this % of the upper circuit (0 = off)
# CIRCUIT_LOWER_BUFFER_PCT=2.0        # no BUY within this % of the lower circuit (0 = off)
# EARNINGS_DAY_BLOCK=true             # no BUY on a stock whose results are dated today
# EARNINGS_CARRY_BLOCK=true           # real-trade: no overnight carry into results today / next trading day
# EARNINGS_FETCH_TIMEOUT_S=6          # real-trade: event-service lookup timeout
# ENTRY_DEPTH_RECHECK=true            # real-trade: re-check spread / book on the fresh tick at BUY time
# OVERNIGHT_HOLD_EXTRA_GAIN_PER_CLOSED_DAY_PCT=0.5   # real-trade: extra carry gain per extra closed day (weekend = 2); 0 = off


# --- group 330 (2026-10-12): India VIX, VWAP, 09:08 pre-open snapshot, negative news, carry context. All fail open; defaults shown. ---
# VIX_GATE_ENABLED=true
# VIX_BLOCK_ABOVE=24            # no new entries at / above this India VIX (0 = off)
# VIX_CAUTION_ABOVE=18          # at / above this, or up VIX_SPIKE_PCT % on the day: size x VIX_CAUTION_SIZE_MULT
# VIX_CAUTION_SIZE_MULT=0.7
# VIX_SPIKE_PCT=10
# VIX_CARRY_BLOCK_ABOVE=20      # real-trade only: no overnight carry at / above this (or up VIX_CARRY_SPIKE_PCT %)
# VIX_CARRY_SPIKE_PCT=6
# VIX_CACHE_TTL_S=120
# VIX_FETCH_TIMEOUT_S=3
# ENTRY_VWAP_GATE_ENABLED=true  # both services (position-stocks since group 333)
# ENTRY_VWAP_TOLERANCE_PCT=0.15
# ENTRY_VWAP_MIN_TIME_IST=09:45         # position-stocks: before this the day's VWAP rests on too few trades, no opinion
# ENTRY_VWAP_MAX_EXTENSION_PCT=0        # position-stocks: > 0 also refuses a chase this far ABOVE the VWAP (0 = off)
# ENTRY_LIQUIDITY_GATE_ENABLED=true     # both services (group 333): volume / turnover floor before a BUY
# ENTRY_MIN_AVG_TURNOVER_CR=3           # normal daily turnover (20-session mean of volume x close), crore Rs; 0 = off
# ENTRY_MIN_DAY_TURNOVER_CR=1           # today's turnover so far, checked from ENTRY_LIQ_MIN_TIME_IST; 0 = off
# ENTRY_LIQ_MIN_TIME_IST=10:00
# ENTRY_MIN_RVOL=0.35                   # day volume / (normal volume x elapsed share of the session), from ENTRY_RVOL_MIN_TIME_IST; 0 = off
# ENTRY_RVOL_MIN_TIME_IST=09:45
# PREOPEN_SNAPSHOT_ENABLED=true
# PREOPEN_SNAPSHOT_TIME_IST=09:10     # group 399: was 09:08
# PREOPEN_SNAPSHOT_PASSES_IST=   # real-trade: comma list of pass times; blank = PREOPEN_SNAPSHOT_TIME_IST, 09:12, 09:14 (each pass adds fresh gaps, never drops one)
# PREOPEN_GAP_GATE_UNTIL_IST=11:00   # position-stocks default 10:00
# PREOPEN_GAP_UP_BLOCK_PCT=6
# PREOPEN_GAP_DOWN_BLOCK_PCT=3
# PREOPEN_MAX_PRICE_AGE_S=420     # group 399: was 180
# PREOPEN_WARM_MAX_SYMBOLS=40   # real-trade; position-stocks uses PREOPEN_MAX_SYMBOLS=150
# group 391: 09:10 opening plan (position-stocks). Before live 5-minute bars exist, the stop/target come from the previous-session daily ATR instead of the flat 2% floor; OPENING_PLAN_ENABLED=0 = old behaviour
# OPENING_PLAN_ENABLED=true
# OPENING_PLAN_TIME_IST=09:10
# OPENING_PLAN_USE_UNTIL_IST=10:00
# OPENING_PLAN_BAR_FRACTION=0.25   # expected 5-minute range as a share of the daily ATR (an assumption, tune from the journal)
# group 392 (position-stocks) + group 394 (real-trade): opening protection, automatic entries only, same variable names in both services. From 09:15 to OPENING_PROTECT_UNTIL_IST the quantity is cut to OPENING_SIZE_MULT, and after OPENING_PAUSE_STOPOUTS stop-outs since the bell no new entry until the window ends (real-trade: losing stop-outs only, and the candidates stay queued); OPENING_PROTECT_ENABLED=0 / false = off
# OPENING_PROTECT_ENABLED=true
# OPENING_PROTECT_UNTIL_IST=09:45
# OPENING_SIZE_MULT=0.5
# OPENING_PAUSE_STOPOUTS=2   # 0 = no pause
# OPENING_PROTECT_MODES=REAL,DEMO   # real-trade only (group 394): which modes are protected; REAL keeps DEMO as an unprotected control
# group 397 (real-trade): peak / trough price since entry is recorded each exit cycle (evidence only); a tick older than this many seconds (when its age is known) is not recorded
# EXCURSION_MAX_TICK_AGE_S=120
# NEWS_NEGATIVE_BLOCK_ENABLED=true
# NEWS_NEGATIVE_BLOCK_SCORE=35  # event score (0-100, 50 neutral) at / below this blocks the BUY
# CARRY_CONTEXT_GATE_ENABLED=true   # real-trade only
# CARRY_MIN_NIFTY_CHANGE_PCT=-0.8
# CARRY_BLOCK_NEGATIVE_NEWS=true
# GLOBAL_CUES_ENABLED=true          # real-trade only: live Europe / Asia / US-futures cues in the carry decision
# GLOBAL_CUE_SYMBOLS=^GDAXI,^FTSE,^N225,^HSI,ES=F,NQ=F
# GLOBAL_CUE_US_FUTURES=ES=F,NQ=F
# GLOBAL_CUE_MIN_READINGS=2         # fewer readings than this = no opinion
# CARRY_GLOBAL_MIN_AVG_PCT=-0.9     # no carry when the average of the cues is at / below this (0 = off)
# CARRY_GLOBAL_US_FUT_MIN_PCT=-1.2  # no carry when any US-futures cue is at / below this (0 = off)
# GLOBAL_CUE_CACHE_TTL_S=300
# GLOBAL_CUE_TIMEOUT_S=12
# GLOBAL_CUE_MAX_AGE_S=21600
# GLOBAL_CUE_ALLOWED=               # market-data: allow-list for GET /global-cues (blank = ^GDAXI,^FTSE,^N225,^HSI,^GSPC,^IXIC,ES=F,NQ=F)
# GLOBAL_CUE_TTL_S=300              # market-data: per-symbol cache
# GLOBAL_CUE_MAX_BAR_AGE_DAYS=1     # market-data: a market whose last bar is older (holiday) is dropped

# ── group 332 (2026-10-12) ───────────────────────────────────────────────────────────────────────────────
# "Best 3 to 5" shortlist (ranking only; never lowers a gate)
# SHORTLIST_ENABLED=1                 position-stocks: 0 = old scan-order entry
# SHORTLIST_MAX=5                     position-stocks: names quality-checked / tried best-first
# SHORTLIST_FALLTHROUGH=1             position-stocks: a symbol-specific skip (VWAP, liquidity, depth, circuit...) tries the next pick; 0 = stop at first skip
# ENTRY_SHORTLIST_ENABLED=true        real-trade Gate 6 shortlist
# ENTRY_SHORTLIST_MAX=5
# ENTRY_SHORTLIST_FALLTHROUGH=true     real-trade: a failed broker placement hands its slot to the next shortlisted pick; false = wait a cycle
# ENTRY_BOARD_NUDGE_ENABLED=true      real-trade: Market Board conviction nudges the composite by at most +/-ENTRY_BOARD_MAX_NUDGE (6)
# ENTRY_FETCH_BY_CONVICTION=true      real-trade: entry pass reads the 20 highest-conviction rows (+5 oldest)
# Weak-market restrictions are OFF by default; to bring any back:
# ENTRY_REGIME_GATE_ENABLED=true      real-trade: "regime WEAK -> no BUY"
# MARKET_GATE_ENABLED=1               position-stocks: Nifty below open / prev close blocks entries
# MARKET_GATE_PREV_CLOSE_ENABLED=1
# CARRY_MIN_NIFTY_CHANGE_PCT=-0.8     real-trade: Nifty-weak overnight-carry block (0 = off)
# VIX_CARRY_BLOCK_ABOVE=20  VIX_CARRY_SPIKE_PCT=6   real-trade carry blocks (0 = off)

# group341 (position-stocks): pool baseline margin fraction (0.20 = intraday margin; 1.0 = old full add-back), per-slot notional cap multiple (0 = off),
# quality-gate result reuse seconds (0 = off), event memory hours (0 = off), tick-buffer cap per symbol, AngelOne movers scrip-master wait seconds
# SCALP_POOL_COMMITTED_MARGIN_FRAC=0.20
# SCALP_SLOT_NOTIONAL_CAP_MULT=1.5
# QUALITY_GATE_RESULT_TTL_S=90
# QUALITY_GATE_EVENT_MEMORY_H=24
# WS_MAX_TICKS_PER_SYMBOL=4000
# ANGELONE_MOVERS_SCRIP_WAIT_S=8

# ---- group344 (13 Oct log review) ------------------------------------------------------------------------------------
# real-trade-service: skip (do not price) a watchlist row that is below / above its catalyst by more than the limit, for this many seconds (0 = off)
WATCHLIST_PARK_S=300
# real-trade-service: while Hot Picks warms, use today's saved Tier 1 snapshot up to this many hours old instead of waiting (0 = off)
WATCHLIST_TIER1_SNAPSHOT_MAX_AGE_H=8
# real-trade-service: pre-open cache warm-up stops after this many seconds (0 = no limit) and, when true, never runs after the 09:15 open
PREOPEN_WARM_BUDGET_S=45
PREOPEN_WARM_STOP_AT_OPEN=true
# real-trade-service: how often to ask market-data whether each held symbol has an AngelOne token / Dhan id (seconds, 0 = off)
HELD_COVERAGE_CHECK_INTERVAL_S=600
# position-stocks-service: block an entry when the news / earnings service cannot be reached (retry once first); fail open after the outage lasts this long
QUALITY_GATE_EVENT_FAIL_BLOCK=true
QUALITY_GATE_EVENT_RETRY_TIMEOUT_S=6
QUALITY_GATE_EVENT_FAIL_OPEN_AFTER_S=900
# position-stocks-service: apply the minimum-price floor before the quality gate; look up a closed trade's exit fill once it is confirmed
PRICE_FLOOR_BEFORE_GATE=true
EXIT_FILL_CONFIRM_ONCE=true
# api-gateway: Surprise scan stops the one-GET-per-symbol fallback after this many seconds (0 = no limit)
SURPRISE_SINGLE_BUDGET_S=10
# market-data-service: first AngelOne candle cooldown (seconds); then it doubles up to the candle ceiling (30 = the old ladder)
ANGELONE_CANDLE_COOLDOWN_BASE_S=90
# group 421 - Buy Sniper card holding text. auto (default) = what the code really does: same day, auto square-off at EOD_SQUAREOFF_TIME_IST, or 'carries 1 night if in profit' for OVERNIGHT_HOLD_ELIGIBLE_LABELS.
# SNIPER_HOLDING_MODE=auto             auto | legacy (the old fixed '2 to 5 Trading Days' label)
# SNIPER_HOLDING_DURATION=             fixed text for every card (wins over the mode); blank = off
# group 357/361 - api-gateway Buy Sniper (/scan/find-buys): daily-structure gate + outcome tracking. Same STRUCTURE_* thresholds as below; no record-only mode.
# SNIPER_STRUCTURE_MODE=enforce       enforce (default; a chasing / stretched / no-room / bearish card is dropped) | off (kill switch). A stale "shadow" means enforce.
# SNIPER_STRUCTURE_FETCH_LIMIT=12     best-conviction candidates without a structure summary that the route fetches from technical /structure/{sym}
# SNIPER_STRUCTURE_FETCH_TIMEOUT_S=10 total time budget for those fetches; a miss = no opinion = card unchanged
# SNIPER_OBS_ENABLED=1                0 = store no sniper observations (GET /scan/find-buys/edge then has nothing new)
# SNIPER_OBS_MAX_PER_DAY=60           cap on observation rows per IST day
# SNIPER_OBS_RETENTION_DAYS=120       how long day shards are kept
# SNIPER_OBS_BATCH=40                 symbols per evaluator pass (QStash tick action "sniper-observe-eval" or POST /scan/find-buys/edge/evaluate)
# SNIPER_OBS_HISTORY_TIMEOUT_S=8      market-data /history timeout per symbol
# group 358 - api-gateway POST /data-feed/refresh-prepare-to-buy: structure notes (log only; the quote refresh itself never changes)
# SNIPER_PREPARE_STRUCTURE_MODE=live  live (default; structure events SELECT extra rows for the PREPARE quote refresh, and the reply carries structure_notes) | off. A stale "log" = live. Independent of SNIPER_STRUCTURE_MODE.
# SNIPER_PREPARE_EVENT_MARGIN=8       group374: rows down to (min_score - this) are picked up by a structure event
# SNIPER_PREPARE_EVENT_MAX=15         group374: at most this many event-selected rows per refresh (0 = none)
# group 360 - api-gateway post-close structure refresh (POST /data-feed/structure-refresh, QStash tick action "structure-refresh"): re-reads only the ms_* block
# STRUCTURE_REFRESH_ENABLED=1         0 = the job answers "disabled"
# STRUCTURE_REFRESH_CONCURRENCY=3     parallel /structure/{sym} fetches
# STRUCTURE_REFRESH_MAX_SYMBOLS=0     cap per run (0 = no cap)
# STRUCTURE_REFRESH_RECHECK_H=6       a row tried within this many hours is not retried (force=true ignores it)
# STRUCTURE_REFRESH_TIMEOUT_S=20      per-symbol timeout
# STRUCTURE_REFRESH_STALE_AFTER_SEC=600  a running job with no progress this long is reported "stalled"
# group378: in-process catch-up (a missed QStash / GitHub trigger, or a restart after 16:00 IST, no longer leaves the feed without structure)
# STRUCTURE_REFRESH_CATCHUP=1          0 = only the external trigger starts the refresh
# STRUCTURE_REFRESH_CATCHUP_INTERVAL_S=1800  how often the gateway checks (floor 60); it only starts a run when the market is closed / holiday
# STRUCTURE_REFRESH_CATCHUP_DELAY_S=180  wait after boot before the first check
# group 356/372 - position-stocks-service structure observation (scalp_structure_observations; background evaluator; GET /structure/edge). Read-only evidence.
# STRUCTURE_OBS_ENABLED=true          false = record and evaluate nothing (also stops the decision service logging every decision, group374)
# STRUCTURE_OBS_SLIPPAGE_PCT=0.1      group374: slippage added to the next-session-open entry when scoring structure observations (0-5)
# STRUCTURE_OBS_SECTOR_INDEX_JSON={}  training: extra/override sector label -> Yahoo index, e.g. {"telecom": "^CNXMEDIA"}; unmapped sectors give no sector return
# STRUCTURE_OBS_EVAL_INTERVAL_S=3600  seconds between evaluator passes (min 60)
# STRUCTURE_OBS_BATCH=25              symbols per evaluator pass
# STRUCTURE_OBS_HISTORY_TIMEOUT_S=8   market-data /history timeout per symbol
# STRUCTURE_OBS_GIVE_UP_DAYS=45       a row with no bars after its day for this long is closed
# STRUCTURE_OBS_BENCH_SYMBOL=NIFTY    group402: real-trade + position-stocks: market benchmark for the observation edge (market-data /history name); empty = no benchmark, bench_ret_* stay empty
# STRUCTURE_EDGE_MIN_N=100            finished rows per side before the edge report draws a conclusion
# SNIPER_OBS_GIVE_UP_DAYS=45         a row with no bars after this many days is closed
# group 351 - daily market-structure gate ("good stock, bad entry?"). Real Trade and Position Stocks have DIFFERENT shipped defaults:
#   real-trade:      STRUCTURE_GATE_MODE=enforce (default since E73, live: WAIT, gate_tag "structure") | log (evaluate + record, never blocks) | off (kill switch). While fewer than STRUCTURE_ENFORCE_MIN_OOS (15) rows with a measured outcome exist, "enforce" still runs as log (B15); STRUCTURE_ENFORCE_MIN_OOS=0 removes that guard.
#   position-stocks: PS_STRUCTURE_GATE_MODE = enforce (default, always live: skip with STRUCTURE_*) | log (E72: evaluate + record, never skips) | off (kill switch).
#                    `log` is accepted ONLY through the PS_ name; the shared STRUCTURE_GATE_MODE (real-trade's switch) is read by position-stocks as off / anything else = enforce, so a shared `log` cannot loosen the scalper.
# STRUCTURE_GATE_MODE=enforce         real-trade REAL (position-stocks also reads this name unless PS_STRUCTURE_GATE_MODE is set, but treats anything except "off" as enforce)
# PS_STRUCTURE_GATE_MODE=enforce      position-stocks only: enforce | log | off
# STRUCTURE_BREAKOUT_VOLUME_MODE=enforce  thin-volume breakout, default enforce since E73 (live, a gate reason). real-trade: enforce | log | off. position-stocks (PS_STRUCTURE_BREAKOUT_VOLUME_MODE wins): enforce | log | off, `log` only via the PS_ name
# STRUCTURE_BREAKOUT_MIN_VOL_RATIO=1.2  both services; 0 = off
# STRUCTURE_GATE_DEMO_MODE=enforce    real-trade DEMO: same values; defaults to STRUCTURE_GATE_MODE
# STRUCTURE_EXIT_MODE=log               real-trade: off | log (default since group 415: record only, nothing raised or sold) | tighten | exit (was the default from group 399 to 414). exit = sell an in-profit position on a fresh bearish daily-structure signal (a loser is never touched); tighten = only raise its stop
# STRUCTURE_REQUIRE_DATA=true         group377 default true: WAIT (structure_nodata) when no usable daily structure; false = no data means no opinion (fail-open)
# STRUCTURE_REQUIRE_FOR_BUY_NOW=true  decision service (group377): a BUY NOW with no usable structure summary becomes WAIT (rule P1_NO_STRUCTURE); false = leave it
# STRUCTURE_MAX_CHASE_ATR=1.5         live price above the nearest demand/imbalance zone top, in ATR (0 disables)
# STRUCTURE_MAX_STRETCH_ATR=3.0       live price above EMA20, in ATR (0 disables)
# STRUCTURE_MIN_ROOM_ATR=0.5          room to the next resistance, in ATR (0 disables)
# STRUCTURE_MIN_RR=0                  structure R:R floor at the live entry (0 disables; group424: default is now 0 because the rule's replay edge was unstable across seeds; set 1.2 for the old floor). The decision policy has the same floor as rr_min in STRUCTURE_POLICY_PARAMS_JSON (default 0)
# STRUCTURE_REJECT_STOP_WIDE=true     structural stop flagged too wide
# STRUCTURE_BEARISH_BLOCK=true        bearish daily trend / fresh (not failed) bearish BOS within STRUCTURE_BEARISH_BOS_BARS (5)
# STRUCTURE_MAX_AGE_DAYS=5            (was 7 until group 415; the plan said 3, but Friday's daily bar is ~3.2-3.4 days old at Monday 09:15 IST) last structure bar older than this = stale = no opinion
# STRUCTURE_MAX_PRICE_DEV_PCT=15      live price vs structure close further apart = split/bad data = no opinion
# STRUCTURE_WAIT_CHASE_ATR=0.75      Buy Sniper card: show "Wait for entry" from this chase in ATR (display only, 0 = never)
# STRUCTURE_STOP_MODE=off             real-trade: off (default since group 415: ATR stop, no structural levels computed) | on (use the structural stop when it is sane)
# STRUCTURE_STOP_MAX_RISK_MULT=1.6    structural risk may be at most this x the ATR-stop risk
# STRUCTURE_STOP_MIN_RISK_MULT=0.5    ... and at least this x
# STRUCTURE_FETCH_ENABLED=true        fetch the summary from api-gateway /stock/{symbol}/structure when the candidate has none (cached, fail-open)
# STRUCTURE_FETCH_TIMEOUT_S=3  STRUCTURE_CACHE_TTL_S=600  STRUCTURE_FAIL_TTL_S=60
# position-stocks-service: Market Board zones/swings from the stockky_ms engine instead of the legacy code (falls back on any error; see GET /board/status ms_engine)
# BOARD_USE_MS_ENGINE=1               default on since group354 (0 = force the legacy board code)
# BOARD_AB_ENABLED=1                  group362: also run the legacy zone maths on the same bars and count differences (read-only; see GET /board/status -> ms_engine.ab)
# BOARD_AB_MAX_COMPARES=100000        comparisons per process (0 = no cap)
# BOARD_GATE_MODE=enforce             position-stocks Market Board chase guard: enforce (default) | off (kill switch)
# group354 position-stocks daily-structure gate (looser than real-trade: the scalper buys strength): STRUCTURE_MAX_CHASE_ATR=4.0 STRUCTURE_MAX_STRETCH_ATR=5.0 STRUCTURE_MIN_ROOM_ATR=0.3 (same names, own defaults per service)
# group 353 - technical service: structure frame (F7) + decision service: daily structure policy
# STRUCTURE_BAR_CLOSE_BUFFER_MIN=20   technical: today's daily bar is dropped from structure until 15:30 IST + this many minutes
# STRUCTURE_PARAMS_JSON={}            technical: engine parameter overrides as JSON (bad JSON / unknown keys ignored)
# CANDIDATE_52W_LOG_ONLY=1            real-trade (group440): compose default is 1 - the 52-week top-12% rule is evaluated, logged and counted (GET /range52w/status) but never rejects. 0 = the rule rejects again (regime-gated, fresh-high exempt). CANDIDATE_52W_RULE_ENABLED=0 = off, no counting
# STRUCTURE_POLICY_MODE=record        decision: compose default is record since group434 (rules logged, none applied). full (live: downgrades + structural stop/target + P9 PREPARE->BUY NOW) | record (group422: every rule is evaluated and logged, NONE applied) | off (kill switch). Any other value (old shadow / caps) = full
# STRUCTURE_POLICY_SHADOW_RULES=      decision: group422 - comma list of rule ids / prefixes that are record-only while all other rules stay live, e.g. P7,P8 (id or prefix up to an underscore: P8 covers P8_NO_BOS; P1_NO_STRUCTURE). Default empty = nothing shadowed. A recorded rule shows as shadow:<id> in the observation and the response carries would_be_decision
# STRUCTURE_POLICY_PARAMS_JSON={}     decision: threshold overrides (group423 adds groups_strict_min: 0 = off default; 2 = P7X_INDEP needs 2 of structure / entry zone / liquidity; run record-only first with STRUCTURE_POLICY_SHADOW_RULES=P7X), e.g. {"chase_atr_max":1.5,"stretch_atr_max":3.0,"rr_min":1.2,"room_atr_min":0.8,"groups_min":2,"loc_min":0,"bos_max_bars":10}   (group410 defaults: groups_min 2, loc_min 0 = off; 0 disables a rule; old: 3 / 55)
# STRUCTURE_PREPARE_UPGRADE=0         decision: P9 - OFF by default since group 415; 1 = a PREPARE TO BUY meeting every BUY NOW requirement + a structure trigger becomes BUY NOW
# STRUCTURE_RETEST_ENTRY=0            decision: group413 P8 retest branch (default OFF) - an old intact bullish BOS passes when price retests a live bullish zone (OB / FVG / golden pocket) AND a bullish CHOCH <= 5 bars old confirms it; window: STRUCTURE_POLICY_PARAMS_JSON {"retest_confirm_bars":5}. Test first: scripts/ms_ab_report.py --policy with th retest_entry 0 vs 1
# group361: Oracle latency probe (all services): a WARNING when one statement or one NEW connection takes this many ms (0 = no slow log). Numbers: GET /ops/db-latency on api-gateway
ORACLE_SLOW_QUERY_MS=1500
# group361: keep-warm: every N seconds touch idle pooled Oracle connections so reconnects / dead-connection replacement happen in the background (0 = off)
ORACLE_KEEPWARM_S=60
# group361: 0 = no per-query / per-connect timing and no keep-warm
ORACLE_LATENCY_PROBE=1

# ---- group370: the structure rules are ALWAYS LIVE (policy full, real-trade / position-stocks / sniper gates enforce, structural stop on). There is no shadow
# (record-only) mode any more; the only switch left for each is `off` (emergency kill switch). Do not put `shadow` in .env: an old value is read as live. ----

# group 425 - real-trade: Kronos forecast gate (Gate 4f). OFF by default and UNPROVEN: run scripts/kronos_backtest.py on history first.
# KRONOS_GATE_MODE=off                off (default) | log (ask the worker, record the verdict, never block) | enforce (WAIT gate_tag "kronos" + Gate 5.6 uses forecast EV). Anything else = off.
# KRONOS_GATE_DEMO_MODE=              DEMO mode: same values; empty = KRONOS_GATE_MODE. Try log or enforce here first.
# KRONOS_URL=http://kronos-forecast-service:8010
# KRONOS_TIMEOUT_S=8                  slower than this = no opinion (never blocks)
# KRONOS_CACHE_TTL_S=900              KRONOS_FAIL_TTL_S=120
# KRONOS_HORIZON_BARS=5               KRONOS_PATHS=10   (10 paths: P(target) moves in steps of 0.1, so keep KRONOS_MIN_P_TARGET low)

# group 434 - real-trade: TimesFM parameter record (Gate 4g). LOG ONLY and UNPROVEN: there is no enforce mode. Needs the timesfm-forecast-service
# (docker compose --profile timesfm up -d --build timesfm-forecast-service) and a nightly `python3 scripts/tsfm_nightly.py` after the EOD bars.
# TIMESFM_GATE_MODE=off               off (default) | log (read the cached forecast, record a hypothetical verdict + one TIMESFM_GATE log line, never block). Anything else = off.
# TIMESFM_GATE_DEMO_MODE=             DEMO mode: same values; empty = TIMESFM_GATE_MODE. Try log here first.
# TIMESFM_URL=http://timesfm-forecast-service:8011      TIMESFM_TIMEOUT_S=1.5  (a cache read; slower = no opinion)
# TIMESFM_MAX_VOL_RATIO=1.6  TIMESFM_MAX_P_STOP=0.35  TIMESFM_MIN_VOLUME_PACE=0.6      hypothetical reject thresholds (0 disables one); hypotheses until Gates A / B pass
# timesfm-forecast-service: TSFM_BACKEND=timesfm25 (default; Apache weights) | bigquery (needs TSFM_BQ_PROJECT) | research-3.0 (needs TSFM_RESEARCH_CHECKPOINT +
#   TSFM_RESEARCH_CLASS; refuses TSFM_TRADE_MODE=REAL) | fake (wiring checks only, no skill).   TSFM_TRADE_MODE=REAL (default) | DEMO.   TSFM_INSTALL=timesfm25|bigquery|none (build arg).
# KRONOS_MIN_EDGE_X_COST=1.0          reject when forecast EV % < this x round-trip cost % (0 disables)
# KRONOS_MIN_P_TARGET=0.10            reject when fewer than this share of paths hit the target before the stop (0 disables)
# KRONOS_PRELOAD=false                worker: load the model at start instead of on the first forecast

# group426 bulk price feed: 1 (default) also prices every symbol already in the feed index, not only the ~500-symbol scan universe (the index held 587, so ~48 symbols were never priced by this job). 0 = scan universe only (old behaviour).
# BULK_FEED_INCLUDE_INDEX=1

# group 468 (real-trade-service)
# APPROVE_FIRST_N=0            approve-first mode: the first N automatic REAL entries after a gate-settings change wait for your approval (dashboard panel / POST /approvals/REAL/{symbol}/approve). 0 = off (default), max 20
# APPROVE_FIRST_TTL_MIN=15     minutes an approval (or a rejection) lasts; an entry not approved in time is not bought
# CANDIDATE_LOG_CONTEXT=1      record Mansfield RS and breadth on every candidate (log only, gates nothing). 0 = off
# CANDIDATE_LOG_CONTEXT_BENCH=^NSEI        benchmark for Mansfield RS
# CANDIDATE_LOG_CONTEXT_RS_BARS=200        daily bars in the RS average

# group 470 (2026-10-20): defaults from the 20 Oct loss review (real-trade-service). Uncomment to override.
# OVERNIGHT_HOLD_ENABLED=false         # was true; one-day holds cost Rs16.8 charges each vs Rs2.0 same-day
# ENTRY_LAST_TIME_IST=14:00            # no new BUY from this time on every day; blank = off
# STOP_OVERSHOOT_ALLOWANCE_PCT=1.0     # size on stop distance + this % of entry; 0 = old sizing
# ORB_MODE=shadow                      # record-only opening-range-breakout verdict in flow_json; off = stop recording

# group 471: whole-day stop-out guard (real-trade). Uncomment to override.
# STOPOUT_GUARD_ENABLED=true
# STOPOUT_DAY_PAUSE_N=3                # losing stop-outs today before entries pause until next session; 0 = off
# STOPOUT_SYMBOL_BLOCK=true            # no same-day re-buy of a symbol that was stopped out

# group 472: minimum shares per REAL entry (0 = off)
# ENTRY_MIN_QTY=3

# group 479 (2026-10-21): position-stocks-service parity with groups 470-472, plus an opt-in same-day broker stop for real-trade. Uncomment to override.
# SCALP_ENTRY_CUTOFF_IST=14:00         # position-stocks: no new scalp after this on any day (default now 14:00; set 23:59 to disable)
# STOPOUT_GUARD_ENABLED=true           # position-stocks reads the same STOPOUT_* names as real-trade (one value in .env applies to both)
# ENTRY_MIN_QTY=3                      # position-stocks: skip an entry that sizes to fewer shares (0 = off); same name as real-trade
# ORB_MODE=shadow                      # position-stocks: record-only opening-range verdict in scalp_positions.flow_json
# TRADE_ODDS_MODE=shadow               # position-stocks: record-only stop-vs-target odds (replay on today's 1-minute bars) in scalp_positions.flow_json; off = stop recording
# TIME_MACHINE_ENABLED=true            # position-stocks: Time Machine routes (odds of one trade on real 5-minute sessions + made-up sessions); evidence only, places nothing
# TIME_MACHINE_SIMS=10000              # made-up sessions per run (1000-50000)
# TIME_MACHINE_SLIPPAGE_PCT=0.05       # % per market leg (entry, stop exit, flat-by exit)
# TIME_MACHINE_LOOKBACK=1mo            # 1mo | 2mo real-history window
# TIME_MACHINE_DEFAULT_VALUE_RS=20000  # trade value used for the charges when a request gives none
# TIME_MACHINE_FETCH_TIMEOUT_S=25      # market-data /history timeout
# BROKER_STOP_INTRADAY=false           # real-trade: resting Dhan stop for same-day INTRADAY positions (needs ENTRY_PRODUCT_MODE=auto). NOT verified live: try ONE small position first

# group 480 (2026-10-21): position-stocks cost gate now counts Dhan's percentage brokerage. Uncomment to override.
# SCALP_COST_GATE_BROKERAGE_PCT=0.03       # % of each leg's value (Dhan intraday: lower of this and the Rs cap); 0 = old Rs 0 brokerage in the gate
# SCALP_COST_GATE_BROKERAGE_CAP_RS=20      # Rs cap per executed leg

# group 481 (2026-10-21): real-trade evidence-gated trade size step-up. Uncomment to override.
# SIZE_LADDER_ENABLED=true                 # false = the plain MAX_TRADE_VALUE cap always
# SIZE_LADDER_STEP_PCT=25                  # cap grows this % per level
# SIZE_LADDER_MAX_LEVEL=2                  # 0 = never grow; level 1 after SIZE_LADDER_MIN_DAYS captured days, level 2 after twice that
# SIZE_LADDER_MIN_DAYS=10
# SIZE_LADDER_MIN_POSITIVE_DAYS_PCT=60     # share of those days that must be net-positive after charges
# SIZE_LADDER_BRAKE_DAYS=3                 # newest N days summing below 0 = level 0

# A11 (2026-10-22): account-wide daily loss cap. Net realized loss today of BOTH engines (real-trade + position-stocks)
# as a % of their combined capital; at or above this, new BUYs are blocked in both. Exits are never blocked.
# The per-service caps (DEFAULT_MAX_DAILY_LOSS_PCT, MAX_DAILY_LOSS_PCT_OF_POOL) still apply. 0 = off. Set the same value for both services.
# ACCOUNT_MAX_DAILY_LOSS_PCT=3.0

# A13 (2026-10-22): hourly read-only broker-vs-book drift check in real-trade (GET /reconcile-report/REAL). Reports positions the
# broker does not hold or holds fewer of, and REAL orders stuck PLACED / PARTIAL; one Telegram message when the drift changes.
# Changes nothing in the book. 0 = off.
# HOURLY_RECONCILE_INTERVAL_MINUTES=60
# HOURLY_RECONCILE_STALE_ORDER_MINUTES=90

# A3 (2026-10-22): write-behind queue in real-trade for evidence-only rows (HOLD exit decisions, plain WAIT entry decisions) so a slow
# or saturated DB (DPY-4024) never delays a stop check or an order. Orders, fills, positions and cash are always written synchronously.
# A DB timeout anywhere in a tick pauses the queue for WRITE_BEHIND_BACKOFF_S. 0 = off (every row written inline as before).
# GET /write-behind/status shows queue depth, rows written / dropped and the back-off.
# WRITE_BEHIND_ENABLED=1
# WRITE_BEHIND_MAX_QUEUE=5000      # oldest row dropped when full
# WRITE_BEHIND_BATCH=50
# WRITE_BEHIND_FLUSH_S=1.0
# WRITE_BEHIND_BACKOFF_S=20

# 2026-10-22: reward:risk 1:2 (one name, both engines; default 2.0, 0 = off). real-trade enforced it already; position-stocks now skips an entry whose FINAL
# target / stop (after the scalp target cap and stop floors) is below it (RR_FLOOR), and ADAPTIVE_BAR_TARGET_RR / SCALP_TARGET_CAP_MIN_RR default to 2.0.
# ENTRY_MIN_REWARD_RISK=2.0

# 2026-10-22: position-stocks moves the stop / target legs to the freshest live tick at order time (same stop % / target %), not the scan price.
# ENTRY_ANCHOR_TO_LIVE=1   # 0 = old behaviour

# 2026-10-23 (E29): one daily digest of fresh chart signals on your WATCHLIST (confirmed breakout / breakdown, golden / death cross, Bollinger squeeze).
# Alert only: nothing trades on it. Sent once after the close; a signal already sent is not repeated for 3-10 days. notification-scheduler-service.
# PATTERN_ALERTS_ENABLED=true       # false = no digest
# PATTERN_ALERTS_TIME=16:05         # IST, weekdays, after the daily bar has closed
# PATTERN_ALERTS_MAX_SYMBOLS=80     # watchlist symbols checked per run
# PATTERN_ALERTS_MAX_LINES=25       # lines in the digest; the rest is summarised as "and N more"
# Try it without sending:  POST <scheduler>/pattern-alerts/run?dry_run=true   (dry_run=false sends)   Status: GET <scheduler>/pattern-alerts/status

# E51: alert switches on the Real Money Calibration page. One random value (16+ characters), the SAME for api-gateway and notification-scheduler-service,
# e.g. `openssl rand -hex 24`. Blank = the Alert switches section shows "not configured" and nothing can be changed.
SCHEDULER_CONTROL_KEY=

# ---- E138: swing momentum lane (real-trade-service, plan: Stockky_Swing_Momentum_Plan.md). Every line is optional and commented: the shipped values are what runs. ----
# The same switches are on the Real Money Calibration page (group "Swing lane"); a value saved there wins. All are protected from the auto-calibrator.
# SWING_MODE=live                     live (default since E224: buys the picks as CNC; DEMO and REAL since E233) | shadow (records what the lane WOULD have bought, orders nothing) | off
# SWING_LIVE_REAL_ENABLED=true        ships true since E233: live mode trades REAL money too. false = DEMO only. (SWING_BROKER_STOP_ENABLED stays false: BROKER_STOP_ENABLED already stops all carried positions)
# SWING_MAX_TRADE_VALUE=20000         Rs per swing position (a flat Rs 14.75 DP fee per carried sale makes a small size too costly: 0.71% round trip at Rs 3,000, 0.30% at Rs 20,000)
# SWING_MAX_POSITIONS=2  SWING_MAX_EXPOSURE_PCT=40  SWING_MAX_PER_SECTOR=1  SWING_PICKS_PER_DAY=2  SWING_MAX_HOLD_DAYS=5
# SWING_UNIVERSE_SYMBOLS=             comma list the evening scan ranks; empty = the built-in list. For like-for-like evidence with the replay: python3 scripts/swing_universe.py HIST_DIR (or runner job swing_universe) prints the line
# SWING_SCAN_TIME_IST=16:00  SWING_ENTRY_TIME_IST=09:25  SWING_ENTRY_LAST_TIME_IST=10:30
# SWING_BROKER_STOP_ENABLED=false     a resting Dhan stop for swing positions only; keep false until the S4 probe (runner job dhan_swing_probe) has PASSed
# Live entries also need the gate's EOD square-off switch ON (it runs the 15:00 hold decision) and, for REAL, the eDIS morning check ON. GET /swing/status -> wiring.problems lists anything missing.
# E138 exit backstop (no setting): a swing position past its last session, or still open 10 minutes after EOD_SQUAREOFF_TIME_IST on its last session, is sold on the next exit tick (reason swing_max_hold).
