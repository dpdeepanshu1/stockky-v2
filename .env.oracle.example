# ============================================================================
#  .env.oracle.example  —  Stockky v2 on the ORACLE CLOUD Ubuntu VM
# ============================================================================
#  Copy this to ".env" ON THE ORACLE VM ONLY:   cp .env.oracle.example .env
#  Then fill in the four values marked  <<< FILL IN >>>  below.
#
#  Render (main branch) keeps using Neon and its own .env — do NOT put these
#  ORACLE_* values there. The SAME application code runs on both; only the
#  environment differs. When ORACLE_DSN is set, the app talks to Oracle
#  Autonomous DB; when it is empty, it talks to Neon/Postgres.
#
#  Step-by-step for where each value comes from: see ORACLE_SETUP_GUIDE.md
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────
#  1) ORACLE AUTONOMOUS DATABASE  (the only truly required block on the VM)
# ─────────────────────────────────────────────────────────────────────────

# TNS alias from the wallet's tnsnames.ora. It is "<dbname>_high|medium|low|tp".
# For a small app, "<dbname>_tp" or "<dbname>_low" is plenty; "_high" is fine too.
# Setting THIS (non-empty) is what switches the whole app onto Oracle.
# Example if your DB is named "stockkydb":  stockkydb_high
ORACLE_DSN=<<< FILL IN: e.g. stockkydb_high >>>

# Database username. On a fresh Autonomous DB this is ADMIN.
ORACLE_USER=ADMIN

# The ADMIN password you typed when you CREATED the Autonomous Database.
ORACLE_PASSWORD=<<< FILL IN: your ADMIN password >>>

# The wallet password you typed when you clicked "Download Wallet".
# (This is NOT the ADMIN password — it protects the wallet's private key.)
ORACLE_WALLET_PASSWORD=<<< FILL IN: your wallet password >>>

# Absolute path ON THE UBUNTU HOST to the UNZIPPED wallet folder (the one that
# contains tnsnames.ora + ewallet.pem). docker-compose mounts it read-only into
# every container at /oracle_wallet.
ORACLE_WALLET_HOST_DIR=/opt/stockky/oracle_wallet

# Path to the wallet INSIDE the containers — leave these exactly as-is; they
# match the mount target in docker-compose.yml. Do not change unless you also
# change the mount.
ORACLE_WALLET_DIR=/oracle_wallet
TNS_ADMIN=/oracle_wallet

# Optional connection-pool tuning (safe defaults for a 2-core / 12 GB VM).
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30


# ─────────────────────────────────────────────────────────────────────────
#  2) NEON / POSTGRES  —  LEAVE EMPTY ON THE ORACLE VM
# ─────────────────────────────────────────────────────────────────────────
#  Keep these blank so the app uses Oracle. (If both ORACLE_DSN and a Postgres
#  URL were set, ORACLE_DSN wins — but keep them empty here to avoid confusion.)
DATABASE_URL=
CACHE_DATABASE_URL=
TRAINING_DATABASE_URL=


# ─────────────────────────────────────────────────────────────────────────
#  3) FRONTEND → BACKEND URL  (baked into the static build at build time)
# ─────────────────────────────────────────────────────────────────────────
#  Your public site is https://stockky.duckdns.org and nginx proxies /api to
#  the api-gateway, so the browser should call /api on the same origin.
VITE_API_URL=https://stockky.duckdns.org/api


# ─────────────────────────────────────────────────────────────────────────
#  4) OPTIONAL — Upstash Redis (fast KV/rate-limit cache in front of the DB)
# ─────────────────────────────────────────────────────────────────────────
#  Leave blank to run without Redis (durable data still lives in Oracle).
#  On a 24/7 VM this is optional; USE_REDIS=0 keeps it fully off.
USE_REDIS=0
DISABLE_UPSTASH=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
#  5) OPTIONAL — notification channels (can also be set in the app UI)
# ─────────────────────────────────────────────────────────────────────────
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CALLMEBOT_PHONE=
# CALLMEBOT_APIKEY=
# CALLMEBOT_USERS=


# ─────────────────────────────────────────────────────────────────────────
#  6) Market-scan tuning (safe on a 2-core VM; same meaning as on Render)
# ─────────────────────────────────────────────────────────────────────────
MAX_PARALLEL_SCAN_WORKERS=18
WAKE_BEFORE_SCAN=true
WAKE_WAIT_SECONDS=8
LAST_FULL_SCAN_TTL=900
DECIDE_CACHE_TTL_OPEN=300
DECIDE_CACHE_TTL_CLOSED=21600
SCAN_LITE_DEFAULT=false
YFINANCE_MAX_CONCURRENT=6
YFINANCE_MIN_INTERVAL_SEC=0.08
DECIDE_BATCH_MAX=25
DECIDE_BATCH_CONCURRENCY=8
TRADE_BACKUP_DIR=/app/data/trade_backups

# ─────────────────────────────────────────────────────────────────────────
#  7) IPO Tracker discovery — same api-gateway service, same meaning as
#     on Render (see .env.example for the full explanation). This VM's
#     own IP is just as likely to be NSE-blocked as Render's, so the same
#     ipoalerts fallback + quota management applies here.
# ─────────────────────────────────────────────────────────────────────────
# Sign up free yourself at https://ipoalerts.in (needs your own email
# verification — can't be generated for you), then paste the key below.
IPOALERTS_API_KEY=
IPOALERTS_DAILY_LIMIT=20
IPOALERTS_RECENT_WINDOW_DAYS=7
IPOALERTS_CACHE_HOURS=6

# ─────────────────────────────────────────────────────────────────────────
#  8) Dhan HQ broker connection (real-trade-service)
#     Entered from the frontend (Real Automatic Trade tab → admin login →
#     Connect Dhan / Rotate Dhan token) — NOT from this file. Only the
#     Client ID and Access Token are ever typed there (generate the token
#     at web.dhan.co → DhanHQ Trading APIs → generate access token); both
#     are encrypted at rest and never sent back to the browser. These vars
#     just configure the service around that.
# ─────────────────────────────────────────────────────────────────────────
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DHAN_CREDENTIAL_ENC_KEY=
DHAN_ENV=sandbox
# Days a pasted Dhan token stays valid before REAL trading auto-disarms
# and asks for a fresh one. Default 30 — check your own Dhan developer
# console if your account's tokens expire on a different schedule.
DHAN_TOKEN_LIFETIME_DAYS=30
DHAN_TOTP_ENABLED=false
