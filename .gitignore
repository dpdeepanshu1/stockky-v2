# `coverage annotate` output (one <file>.py,cover next to every source file)
*,cover

# Secrets and saved run output (A4/A5, 2026-10-22): never commit real env files
# or captured command output that may contain tokens/JWTs.
.env.*
!.env.example
!.env.oracle.example
!.env.oracle.recommended
*.token
*.jwt
run_output*/
*_run_output*
*.run.log
.venv-test/

# E245: the repo keeps only README.md and CHANGELOG.md. Other Markdown files are ignored so a stale zip or a new note cannot sneak back in
# (already-tracked files are unaffected; add a bullet to CHANGELOG.md instead of a new note).
*.md
!README.md
!CHANGELOG.md
*.conflict-backup

# E285 round 122: local snapshot output written by the VM tooling
snap.jsonl

# round 588: local VM leftovers that a blanket `git add` once pushed (real-trade records, order-probe output, backups, scratch reports).
# Only untracked files are affected; nothing already in git changes.
data/fno_real_probe/
data/fno_rolling/
data/fno_rolling_long/
*.bak
*.bak.*
*.backup-*
/headlines.csv
/merged-log.txt
/ps_report.txt
/rt_*.json
/rt_*.txt
/vm_full_check.sh
services/analysis-intelligence-service/headlines.txt

# round 592: screenshots written by `node scripts/ui-baseline.mjs` (frontend/ui-baseline/<label>/<theme>-<size>/*.png). Local before/after output, not release code;
# a blanket `git add -A` pushed frontend/ui-baseline/r532/light-phone/*.png and CI then reported them as tracked files missing from the manifest.
# On the VM / PC, once: `git rm -r --cached frontend/ui-baseline` (keeps the files on disk), then commit.
frontend/ui-baseline/

# round 678: local output of scripts/fno_rolling_*.py (last_<index>_<strategy>.log, saved run text). A blanket `git add -A` pushed them and CI listed them as
# tracked files missing from the manifest. Once on the VM / PC: `git rm -r --cached data/fno_rolling_out docs/fno_rolling_nifty_20261120` (files stay on disk).
data/fno_rolling_out/
docs/fno_rolling_nifty_*/

# round 679: saved daily gate reads (scripts/gates_daily.sh) - local evidence, not release code
gates_out/
