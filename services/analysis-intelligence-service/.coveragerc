# Run from services/analysis-intelligence-service.
# The sub-app folders (event/, fundamental/, ...) have no __init__.py, so `source = .` alone
# skips any file in them that no test imports. Listing each folder as its own source root makes
# coverage walk it, so untested files (event/main.py, ...) show up as 0% instead of being hidden.
[run]
source =
    .
    event
    fundamental
    news
    sentiment
    technical
omit =
    tests/*
    */__pycache__/*
    .venv/*
    # group413: vendored stockky_ms modules this service never imports (offline replay/backtest tooling used by
    # real-trade-service and the scripts). They sat at 0% and pulled the total under the 95% gate in run_tests.sh.
    stockky_ms/backtest.py
    stockky_ms/observation.py
    stockky_ms/replay.py
    stockky_ms/candles.py
    stockky_ms/compat_board.py

[report]
show_missing = True
skip_empty = True
