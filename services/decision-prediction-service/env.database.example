# Copy these into Render → decision-prediction-service → Environment

# Required for durable win-rate, T+1/T+5 outcomes, paper trades, training history.
# Without this, sqlite on ephemeral disk is used and resets on every redeploy.
#
# Neon: https://neon.tech → create project → Connection string (pooled)
# Supabase: https://supabase.com → Project Settings → Database → URI
#
# Use the pooled connection string when available (Neon pooler / Supabase pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional pool tuning for free Postgres
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=280
