# ============================================================================
#  .env  —  Stockky v2 on the ORACLE CLOUD Ubuntu VM (2 vCPU / 12 GB)
#  Copy this file to ".env" in the repo root on the VM, then fill in the
#  <<< FILL IN >>> values. Everything else is a tuned value, not a placeholder.
#
#  WHAT WAS DELIBERATELY *NOT* CHANGED, AND WHY:
#  MAX_PARALLEL_SCAN_WORKERS, YFINANCE_MAX_CONCURRENT,
#  YFINANCE_MIN_INTERVAL_SEC, DECIDE_CACHE_TTL_*, WATCHLIST_SCAN_* are all
#  calibrated against Yahoo/NSE's own rate limits and against how fresh a
#  price is allowed to get before it's stale — not against local CPU. Your
#  VM being dedicated (vs. Render's shared free tier) doesn't raise Yahoo's
#  tolerance for concurrent requests from one IP. Pushing these up risks
#  429s/blocks and *shallower* data (more fallback/cached hits), which is
#  the opposite of what you asked for — so they're kept at the values this
#  codebase's own comments say were hard-won. The real, safe speed wins on
#  a small VM are elsewhere: fewer idle DB connections, lighter frontend,
#  and giving the OS breathing room — see the sections below.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
#  1) ORACLE AUTONOMOUS DATABASE
# ─────────────────────────────────────────────────────────────────────────
ORACLE_DSN=<<< FILL IN: e.g. stockkydb_high >>>
ORACLE_USER=ADMIN
ORACLE_PASSWORD=<<< FILL IN: your ADMIN password >>>
ORACLE_WALLET_PASSWORD=<<< FILL IN: your wallet password >>>
ORACLE_WALLET_HOST_DIR=/opt/stockky/oracle_wallet
ORACLE_WALLET_DIR=/oracle_wallet
TNS_ADMIN=/oracle_wallet

# ── Main-engine connection pool (per service) ──────────────────────────────
# Was 3+2=5 max per service. A dedicated small VM has low concurrent
# request volume (personal use, not a shared free tier), so fewer pooled
# connections means less idle TLS-session overhead against the wallet and
# less RAM per service, with zero effect on correctness — pool_pre_ping
# (already on in code) still catches a dead connection immediately and
# opens a fresh one on demand.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
# Was 300s (5 min) — raised to 30 min. pool_pre_ping already validates
# liveness cheaply before every checkout, so there's no correctness reason
# to force a full wallet TLS handshake every 5 minutes; this just avoids
# needless reconnect churn on an idle-most-of-the-day personal app.
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ── KV-cache durable-layer pool (per service, Oracle path) ─────────────────
# THIS is the one that matters most: each service opens a SEPARATE Oracle
# engine for its KV-cache durability table (watchlist/data-feed/fundamentals
# persistence), on top of the main engine above. Its Oracle-path defaults
# in code are 5+3=8 per service — meaning six services could together open
# up to (5+8)*6 ≈ 78 Oracle sessions in the worst case. That's the single
# biggest connection-count risk on a small Autonomous DB instance (you'll
# see ORA-12520 "no more sessions" under load if left at defaults). The
# in-process memory cache in front of it (always on, free) already serves
# almost every read — the DB is only actually hit on a cold start or a
# genuine cache miss — so shrinking this pool costs you nothing in practice.
CACHE_DB_POOL_SIZE_ORACLE=2
CACHE_DB_MAX_OVERFLOW_ORACLE=1
CACHE_DB_POOL_RECYCLE=1800
CACHE_DB_POOL_TIMEOUT=10

# ─────────────────────────────────────────────────────────────────────────
#  2) NEON / POSTGRES — leave empty on the Oracle VM
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=
CACHE_DATABASE_URL=
TRAINING_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────
#  3) FRONTEND → BACKEND URL (baked in at build time)
# ─────────────────────────────────────────────────────────────────────────
VITE_API_URL=https://stockky.duckdns.org/api

# ─────────────────────────────────────────────────────────────────────────
#  4) Redis — keep OFF. On a single dedicated VM, the in-process memory
#     cache (always on, zero network hop) + the Oracle durable table above
#     already covers both speed and restart-durability. Routing through
#     Upstash's cloud REST API would ADD a network round trip per cache
#     operation instead of removing one — the opposite of faster.
# ─────────────────────────────────────────────────────────────────────────
USE_REDIS=0
DISABLE_UPSTASH=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
#  5) Notification channels (optional; can also be set in the app UI)
# ─────────────────────────────────────────────────────────────────────────
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CALLMEBOT_PHONE=
# CALLMEBOT_APIKEY=
# CALLMEBOT_USERS=

# ─────────────────────────────────────────────────────────────────────────
#  6) Market-scan tuning — UNCHANGED from the repo's own hard-won defaults.
#     See the note at the top of this file for why these are left alone.
# ─────────────────────────────────────────────────────────────────────────
MAX_PARALLEL_SCAN_WORKERS=18
WAKE_BEFORE_SCAN=true
WAKE_WAIT_SECONDS=8
LAST_FULL_SCAN_TTL=900
DECIDE_CACHE_TTL_OPEN=300
DECIDE_CACHE_TTL_CLOSED=21600
SCAN_LITE_DEFAULT=false
YFINANCE_MAX_CONCURRENT=6
YFINANCE_MIN_INTERVAL_SEC=0.08
DECIDE_BATCH_MAX=25
DECIDE_BATCH_CONCURRENCY=8
TRADE_BACKUP_DIR=/app/data/trade_backups
PEER_FUNDAMENTALS_CACHE_TTL_SECONDS=60
PEER_FUNDAMENTALS_FETCH_WORKERS=6
WATCHLIST_SCAN_CONCURRENCY=4
WATCHLIST_SCAN_HTTP_CONCURRENCY=8
WATCHLIST_SCAN_TIMEOUT_SECONDS=18
WATCHLIST_SCAN_GRACE_SECONDS=30

# ─────────────────────────────────────────────────────────────────────────
#  7) IPO Tracker discovery (optional, needs your own free ipoalerts.in key)
# ─────────────────────────────────────────────────────────────────────────
IPOALERTS_API_KEY=
IPOALERTS_DAILY_LIMIT=20
IPOALERTS_RECENT_WINDOW_DAYS=7
IPOALERTS_CACHE_HOURS=6

# ─────────────────────────────────────────────────────────────────────────
#  8) AngelOne SmartAPI (market-data-service primary quote source)
#     Fill these in — AngelOne is your primary/fastest source; without all
#     four, the service silently falls back to yfinance only.
# ─────────────────────────────────────────────────────────────────────────
ANGELONE_CLIENT_ID=<<< FILL IN >>>
ANGELONE_MPIN=<<< FILL IN >>>
ANGELONE_API_KEY=<<< FILL IN >>>
ANGELONE_TOTP_SECRET=<<< FILL IN >>>

# ─────────────────────────────────────────────────────────────────────────
#  9) Dhan HQ broker connection (real-trade-service)
# ─────────────────────────────────────────────────────────────────────────
DHAN_CREDENTIAL_ENC_KEY=<<< FILL IN: generate with the python -c Fernet command in real-trade-service/README or config.py >>>
DHAN_ENV=sandbox
DHAN_TOKEN_LIFETIME_DAYS=1
DHAN_TOTP_ENABLED=false
DHAN_TOTP_SECRET=
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_REFRESH_MARGIN_HOURS=2
DHAN_TOTP_REFRESH_CHECK_INTERVAL_SECONDS=900

# ── Auto-Pilot / scheduled automation timing (unchanged defaults) ──
AUTO_PILOT_INTERVAL_SECONDS=180
AUTO_PILOT_NOTIFY_HEARTBEAT=false
PREPICK_TIME_IST=09:00
ENTER_AT_OPEN_TIME_IST=09:20
EOD_SQUAREOFF_TIME_IST=15:15
SCHEDULE_CHECK_INTERVAL_SECONDS=60
EXIT_CHECK_INTERVAL_SECONDS=45
